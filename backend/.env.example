ENTORNO=desarrollo
LOG_LEVEL=INFO
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/icat

# Admin local de desarrollo (U-21). Sin estas dos variables no se siembra.
# Lleva los tres roles y el arranque lo deja activo.
ADMIN_EMAIL=admin@icat.local
ADMIN_PASSWORD=cambiar-en-local

# Sesiones (U-17/U-18)
SESSION_HORAS=1
SESSION_HORAS_MAX=12
SESIONES_MAX=3

# Documentos: clave Fernet del original cifrado. Generar con:
# .venv\Scripts\python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STORAGE_DIR=storage
STORAGE_KEY=
MAX_UPLOAD_MB=20

# OCR: PaddleOCR-VL por Ollama. OCR_MOCK=1 usa la capa de texto del PDF (o un texto fijo) sin modelo.
OCR_MOCK=0
OLLAMA_URL=http://localhost:11434
OCR_MODEL=hf.co/PaddlePaddle/PaddleOCR-VL-1.6-GGUF:latest
CONTRASTE_MINIMO=80

# Presidio: python -m spacy download es_core_news_md
SPACY_MODEL=es_core_news_md

# SharePoint (opcional): PDF dejados en <CARPETA>/<Nombre Persona>/ se suben solos y se transcriben.
# App de Entra ID con permiso de aplicación Files.ReadWrite.All (o Sites.Selected sobre el sitio).
SHAREPOINT_TENANT_ID=
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=
SHAREPOINT_DRIVE_ID=
SHAREPOINT_CARPETA=Entrada
SHAREPOINT_SONDEO_SEG=60
